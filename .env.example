# Copy to .env for local runs. On Vercel, set the same names under Project > Settings > Environment Variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MODEL_CHEAP=gpt-6-luna

# Optional: only if the brief needs voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=

# Optional: only if the brief needs persistence.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 1 = sample cases are served from data/precomputed.json (safe for recording). 0 = always call the model.
DEMO_FROZEN=1
